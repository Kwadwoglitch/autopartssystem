
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Profit and Loss Report | Car Parts System</title>

    <!-- Chart.js library for graphical reports -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>

	
        /* ===== Car Parts System: Navy & Electric Blue Theme ===== */
        :root {
            --report-bg: #080f25;
            --report-panel: #10264b;
            --report-panel-light: #142f59;
            --report-blue: #1677ff;
            --report-cyan: #00c8ff;
            --report-text: #f1f5ff;
            --report-muted: #b7c8e6;
            --report-border: rgba(148, 181, 231, 0.2);
        }

        body {
            background: var(--report-bg);
            color: var(--report-text);
        }

        .header,
        .panel,
        .metric,
        .chart-panel {
            background: linear-gradient(
                145deg,
                var(--report-panel-light),
                var(--report-panel)
            );
            color: var(--report-text);
            border: 1px solid var(--report-border);
            border-radius: 13px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
        }

        h1,
        h2,
        h3 {
            color: var(--report-text);
        }

        .back-link {
            color: var(--report-cyan);
        }

        .back-link:hover {
            color: #ffffff;
        }

        .filters label {
            color: var(--report-muted);
        }

        .filters select,
        .filters input {
            background: #091832;
            color: var(--report-text);
            border: 1px solid #35527b;
        }

        .filters select:focus,
        .filters input:focus {
            outline: 2px solid var(--report-blue);
            outline-offset: 1px;
        }

        button,
        .button {
            background: var(--report-blue);
            color: #ffffff;
            border: 1px solid transparent;
            border-radius: 7px;
            font-weight: 600;
            transition: background 0.2s ease;
        }

        button:hover,
        .button:hover {
            background: #075bd0;
        }

        .metric p,
        .chart-panel p,
        .report-meta,
        .chart-note {
            color: var(--report-muted);
        }

        .amount {
            color: var(--report-cyan);
        }

        .positive {
            color: #35d6a0;
        }

        .negative {
            color: #ff8585;
        }

        .warning {
            background: rgba(255, 189, 89, 0.12);
            color: #ffd28a;
            border: 1px solid rgba(255, 189, 89, 0.35);
            border-radius: 8px;
        }

        .error {
            background: rgba(255, 90, 90, 0.12);
            color: #ffaaaa;
            border: 1px solid rgba(255, 90, 90, 0.35);
            border-radius: 8px;
        }

        .report-table th,
        .report-table td {
            border-bottom: 1px solid var(--report-border);
        }

        .report-table th {
            color: var(--report-muted);
            background: rgba(7, 17, 38, 0.35);
        }

        .report-table td {
            color: var(--report-text);
        }

        .report-table tr:hover {
            background: rgba(22, 119, 255, 0.08);
        }

        .report-table .total-row th,
        .report-table .total-row td {
            border-top: 2px solid #35527b;
            color: var(--report-cyan);
        }

        .empty-state {
            background: rgba(7, 17, 38, 0.45);
            color: var(--report-muted);
            border: 1px solid var(--report-border);
        }

        .chart-container {
            min-width: 0;
        }

        /* Keep printed financial reports legible */
        @media print {
            body {
                background: #ffffff !important;
                color: #000000 !important;
            }

            .header,
            .panel,
            .metric,
            .chart-panel {
                background: #ffffff !important;
                color: #000000 !important;
                border: 1px solid #cccccc !important;
                box-shadow: none !important;
                break-inside: avoid;
            }

            h1,
            h2,
            h3,
            .metric p,
            .chart-panel p,
            .report-meta,
            .chart-note,
            .report-table th,
            .report-table td,
            .amount,
            .positive,
            .negative {
                color: #000000 !important;
            }

            .report-table th {
                background: #eeeeee !important;
            }

            .report-table th,
            .report-table td {
                border-color: #cccccc !important;
            }

            .warning,
            .error,
            .empty-state {
                background: #ffffff !important;
                color: #000000 !important;
                border: 1px solid #999999 !important;
            }

            .developer-footer {
                display: none !important;
            }
        }
	

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 24px;
            background: #f4f6f9;
            color: #202938;
            font-family: Arial, sans-serif;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .header,
        .panel,
        .metric,
        .chart-panel {
            background: #fff;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        h1, h2, h3 {
            margin-top: 0;
        }

        h1 {
            font-size: 28px;
        }

        h2 {
            font-size: 20px;
        }

        p {
            line-height: 1.6;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 20px;
            color: #174ea6;
            text-decoration: none;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        .filters {
            display: flex;
            flex-wrap: wrap;
            align-items: end;
            gap: 12px;
        }

        .filters > div {
            flex: 1 1 180px;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-weight: bold;
        }

        select,
        input,
        button,
        .button {
            width: 100%;
            padding: 11px;
            border: 1px solid #cbd2dc;
            border-radius: 6px;
            font-size: 14px;
        }

        button,
        .button {
            width: auto;
            background: #174ea6;
            color: #fff;
            border: none;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }

        button:hover,
        .button:hover {
            background: #123b80;
        }

        .metrics {
            display: grid;
            grid-template-columns: repeat(
                auto-fit,
                minmax(210px, 1fr)
            );
            gap: 16px;
            margin-bottom: 20px;
        }

        .metric {
            min-width: 0;
            margin-bottom: 0;
        }

        .metric p {
            color: #606b7a;
            margin-top: 0;
            margin-bottom: 10px;
        }

        .amount {
            font-size: 23px;
            font-weight: bold;
            overflow-wrap: anywhere;
        }

        .positive {
            color: #147d46;
        }

        .negative {
            color: #b42318;
        }

        .warning {
            padding: 14px;
            border-radius: 6px;
            background: #fff3cd;
            color: #664d03;
            margin-bottom: 20px;
        }

        .error {
            padding: 14px;
            border-radius: 6px;
            background: #fce8e6;
            color: #b42318;
            margin-bottom: 20px;
        }

        .report-table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .report-table {
            width: 100%;
            border-collapse: collapse;
        }

        .report-table th,
        .report-table td {
            padding: 13px 8px;
            border-bottom: 1px solid #e5e7eb;
            text-align: left;
        }

        .report-table td:last-child,
        .report-table th:last-child {
            text-align: right;
        }

        .report-table th {
            font-weight: 600;
        }

        .report-table .total-row th,
        .report-table .total-row td {
            border-top: 2px solid #cbd2dc;
            font-weight: bold;
        }

        .charts-grid {
            display: grid;
            grid-template-columns: repeat(
                auto-fit,
                minmax(min(100%, 320px), 1fr)
            );
            gap: 20px;
            margin-top: 20px;
            margin-bottom: 20px;
        }

        .chart-panel {
            min-width: 0;
            margin-bottom: 0;
        }

        .chart-panel p {
            color: #606b7a;
        }

        .chart-container {
            position: relative;
            width: 100%;
            height: 320px;
        }

        .chart-note {
            font-size: 13px;
            color: #606b7a;
            margin-top: 12px;
        }

        .empty-state {
            padding: 18px;
            background: #f4f6f9;
            border-radius: 6px;
            text-align: center;
            color: #606b7a;
        }

        .report-meta {
            color: #606b7a;
        }

        .section-heading {
            margin-bottom: 12px;
        }

        .no-print {
            display: inline-block;
        }

        @media (max-width: 600px) {
            body {
                padding: 12px;
            }

            .header,
            .panel,
            .metric,
            .chart-panel {
                padding: 15px;
            }

            h1 {
                font-size: 23px;
            }

            .amount {
                font-size: 21px;
            }

            .chart-container {
                height: 270px;
            }

            .report-table th,
            .report-table td {
                padding: 10px 5px;
                font-size: 13px;
            }

            .filters button {
                width: 100%;
            }
        }

        @media print {
            @page {
                margin: 12mm;
            }

            body {
                background: #fff;
                padding: 0;
                color: #000;
            }

            .container {
                max-width: none;
            }

            .filters,
            .back-link,
            .no-print {
                display: none !important;
            }

            .header,
            .panel,
            .metric,
            .chart-panel {
                box-shadow: none;
                border: 1px solid #ddd;
                break-inside: avoid;
            }

            .metrics {
                grid-template-columns: repeat(2, 1fr);
            }

            .charts-grid {
                display: block;
            }

            .chart-panel {
                margin-bottom: 16px;
            }

            .chart-container {
                height: 260px;
            }

            .warning,
            .error {
                border: 1px solid #999;
            }
        }
    </style>
</head>

<body>
<div class="container">

    <!-- Navigation -->
    <a class="back-link"
       href="{% url 'products:dashboard' %}">
        &larr; Back to Dashboard
    </a>

    <!-- Report heading -->
    <header class="header">
        <h1>Profit and Loss Report</h1>

        <p>
            Review sales revenue, returns, inventory costs,
            operating expenses, gross profit, and net profit
            for your selected reporting period.
        </p>

        <button class="no-print"
                type="button"
                onclick="window.print()">
            Print Report
        </button>
    </header>

    <!-- Reporting period filters -->
    <section class="panel">
        <h2>Select Reporting Period</h2>

        <form method="get" class="filters">

            <div>
                <label for="period">Period</label>

                <select name="period"
                        id="period"
                        onchange="toggleCustomDates()">

                    <option value="day"
                        {% if period == "day" %}selected{% endif %}>
                        Today
                    </option>

                    <option value="month"
                        {% if period == "month" %}selected{% endif %}>
                        This Month
                    </option>

                    <option value="year"
                        {% if period == "year" %}selected{% endif %}>
                        This Year
                    </option>

                    <option value="custom"
                        {% if period == "custom" %}selected{% endif %}>
                        Custom Dates
                    </option>

                </select>
            </div>

            <div class="custom-date">
                <label for="start_date">Start Date</label>

                <input type="date"
                       name="start_date"
                       id="start_date"
                       value="{{ start_date|date:'Y-m-d' }}">
            </div>

            <div class="custom-date">
                <label for="end_date">End Date</label>

                <input type="date"
                       name="end_date"
                       id="end_date"
                       value="{{ end_date|date:'Y-m-d' }}">
            </div>

            <div>
                <button type="submit">
                    Generate Report
                </button>
            </div>

        </form>
    </section>

    <!-- Validation errors -->
    {% if error %}
        <div class="error" role="alert">
            <strong>Unable to generate report:</strong>
            {{ error }}
        </div>
    {% endif %}

    {% if report %}

        <!-- Report period -->
        <section class="panel">
            <h2>Reporting Period</h2>

            <p>
                <strong>From:</strong>
                {{ report.start_date|date:"d M Y" }}

                &nbsp; | &nbsp;

                <strong>To:</strong>
                {{ report.end_date|date:"d M Y" }}
            </p>

            <p class="report-meta">
                Completed sales: {{ report.sales_count }}
                &nbsp; | &nbsp;
                Returns recorded: {{ report.returns_count }}
                &nbsp; | &nbsp;
                Expenses recorded: {{ report.expense_count }}
            </p>
        </section>

        <!-- Historical cost warning -->
        {% if not report.costs_complete %}
            <div class="warning" role="alert">
                <strong>Historical cost data is incomplete.</strong>

                Reliable gross and net profit figures cannot
                be calculated for the entire selected period
                because {{ report.unknown_cost_units }}
                item unit(s) have unknown historical costs.

                Review the affected sale or return records.
                Missing monthly profit values will be displayed
                as gaps in the profit trend.
            </div>
        {% endif %}

        <!-- Financial summary cards -->
        <section class="metrics">

            <article class="metric">
                <p>Sales Revenue</p>

                <div class="amount">
                    GH₵ {{ report.sales_revenue|floatformat:2 }}
                </div>
            </article>

            <article class="metric">
                <p>Sales Returns</p>

                <div class="amount negative">
                    GH₵ {{ report.sales_returns|floatformat:2 }}
                </div>
            </article>

            <article class="metric">
                <p>Net Sales</p>

                <div class="amount">
                    GH₵ {{ report.net_sales|floatformat:2 }}
                </div>
            </article>

            <article class="metric">
                <p>Net Cost of Goods Sold</p>

                <div class="amount">
                    GH₵ {{ report.net_cost_of_goods_sold|floatformat:2 }}
                </div>
            </article>

            <article class="metric">
                <p>Gross Profit</p>

                <div class="amount
                    {% if report.gross_profit != None and report.gross_profit < 0 %}
                        negative
                    {% elif report.gross_profit != None and report.gross_profit > 0 %}
                        positive
                    {% endif %}">

                    {% if report.gross_profit != None %}
                        GH₵ {{ report.gross_profit|floatformat:2 }}
                    {% else %}
                        Unavailable
                    {% endif %}

                </div>
            </article>

            <article class="metric">
                <p>Operating Expenses</p>

                <div class="amount">
                    GH₵ {{ report.operating_expenses|floatformat:2 }}
                </div>
            </article>

            <article class="metric">
                <p>Net Profit</p>

                <div class="amount
                    {% if report.net_profit != None and report.net_profit < 0 %}
                        negative
                    {% elif report.net_profit != None and report.net_profit > 0 %}
                        positive
                    {% endif %}">

                    {% if report.net_profit != None %}
                        GH₵ {{ report.net_profit|floatformat:2 }}
                    {% else %}
                        Unavailable
                    {% endif %}

                </div>
            </article>

        </section>

        <!-- Detailed financial statement -->
        <section class="panel">
            <h2 class="section-heading">
                Detailed Profit and Loss Statement
            </h2>

            <div class="report-table-wrapper">
                <table class="report-table">
                    <tbody>

                        <tr>
                            <th scope="row">Sales Revenue</th>
                            <td>
                                GH₵ {{ report.sales_revenue|floatformat:2 }}
                            </td>
                        </tr>

                        <tr>
                            <th scope="row">Less: Sales Returns</th>
                            <td>
                                GH₵ {{ report.sales_returns|floatformat:2 }}
                            </td>
                        </tr>

                        <tr class="total-row">
                            <th scope="row">Net Sales</th>
                            <td>
                                GH₵ {{ report.net_sales|floatformat:2 }}
                            </td>
                        </tr>

                        <tr>
                            <th scope="row">
                                Cost of Goods Sold Before Returns
                            </th>
                            <td>
                                GH₵ {{ report.cost_of_goods_sold|floatformat:2 }}
                            </td>
                        </tr>

                        <tr>
                            <th scope="row">
                                Less: Cost of Restocked Returns
                            </th>
                            <td>
                                GH₵ {{ report.returned_inventory_cost|floatformat:2 }}
                            </td>
                        </tr>

                        <tr class="total-row">
                            <th scope="row">Net Cost of Goods Sold</th>
                            <td>
                                GH₵ {{ report.net_cost_of_goods_sold|floatformat:2 }}
                            </td>
                        </tr>

                        <tr>
                            <th scope="row">Gross Profit</th>
                            <td>
                                {% if report.gross_profit != None %}
                                    GH₵ {{ report.gross_profit|floatformat:2 }}
                                {% else %}
                                    Unavailable
                                {% endif %}
                            </td>
                        </tr>

                        <tr>
                            <th scope="row">Less: Operating Expenses</th>
                            <td>
                                GH₵ {{ report.operating_expenses|floatformat:2 }}
                            </td>
                        </tr>

                        <tr class="total-row">
                            <th scope="row">Net Profit</th>
                            <td>
                                {% if report.net_profit != None %}
                                    GH₵ {{ report.net_profit|floatformat:2 }}
                                {% else %}
                                    Unavailable
                                {% endif %}
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </section>

        <!-- Graphical reports -->
        <section class="charts-grid">

            <!-- Chart 1: Financial comparison -->
            <article class="chart-panel">
                <h2>Financial Comparison</h2>

                <p>
                    Compare net sales, net cost of goods sold,
                    and operating expenses for this period.
                </p>

                <div class="chart-container">
                    <canvas id="financialChart"></canvas>
                </div>
            </article>

            <!-- Chart 2: Expense breakdown -->
            <article class="chart-panel">
                <h2>Expense Breakdown</h2>

                <p>
                    See how recorded operating expenses are
                    distributed across the shop's categories.
                </p>

                <div class="chart-container">
                    <canvas id="expenseChart"></canvas>
                </div>

                <p id="expenseEmptyMessage"
                   class="empty-state"
                   hidden>
                    No expenses were recorded during this period.
                </p>
            </article>

            <!-- Chart 3: Monthly profit trend -->
            <article class="chart-panel">
                <h2>Monthly Profit Trend</h2>

                <p>
                    Compare monthly net profit over the selected
                    reporting period.
                </p>

                <div class="chart-container">
                    <canvas id="profitChart"></canvas>
                </div>

                <p class="chart-note">
                    A gap in the line indicates that reliable
                    profit data is unavailable for that month
                    because historical costs are missing.
                </p>
            </article>

        </section>

        <!-- Safely pass Django data to JavaScript -->
        {{ financial_chart|json_script:"financial-chart-data" }}
        {{ expense_chart|json_script:"expense-chart-data" }}
        {{ profit_chart|json_script:"profit-chart-data" }}

        <script>
            "use strict";

            /*
             * Read JSON generated by Django.
             * Return empty arrays if data is missing or invalid.
             */
            function readChartData(elementId) {
                const element = document.getElementById(elementId);

                if (!element) {
                    console.error(
                        "Chart data element not found:",
                        elementId
                    );

                    return { labels: [], values: [] };
                }

                try {
                    const data = JSON.parse(element.textContent);

                    if (
                        !data ||
                        !Array.isArray(data.labels) ||
                        !Array.isArray(data.values)
                    ) {
                        throw new Error(
                            "Chart data must contain labels and values arrays."
                        );
                    }

                    return data;

                } catch (error) {
                    console.error(
                        "Unable to read chart data:",
                        error
                    );

                    return { labels: [], values: [] };
                }
            }

            /*
             * Format numbers as Ghana cedis.
             */
            function formatCedi(value) {
                return "GH₵ " + Number(value).toLocaleString(
                    "en-GH",
                    {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }
                );
            }

            /*
             * Show a message when Chart.js cannot load.
             */
            function showChartError() {
                document.querySelectorAll(".chart-panel").forEach(
                    function(panel) {
                        const message = document.createElement("p");

                        message.className = "warning";
                        message.textContent =
                            "Charts could not load. Check your internet " +
                            "connection and reload the page.";

                        panel.appendChild(message);
                    }
                );
            }

            /*
             * Initialize the charts.
             */
            function initializeCharts() {
                if (typeof Chart === "undefined") {
                    showChartError();
                    return;
                }

                const financialData = readChartData(
                    "financial-chart-data"
                );

                const expenseData = readChartData(
                    "expense-chart-data"
                );

                const profitData = readChartData(
                    "profit-chart-data"
                );

                /*
                 * Chart 1: Financial comparison.
                 */
                new Chart(
                    document.getElementById("financialChart"),
                    {
                        type: "bar",

                        data: {
                            labels: financialData.labels,

                            datasets: [{
                                label: "Amount (GH₵)",
                                data: financialData.values,

                                backgroundColor: [
                                    "#2563eb",
                                    "#f59e0b",
                                    "#dc2626"
                                ],

                                borderRadius: 5
                            }]
                        },

                        options: {
                            responsive: true,
                            maintainAspectRatio: false,

                            scales: {
                                y: {
                                    beginAtZero: true,

                                    ticks: {
                                        callback: function(value) {
                                            return "GH₵ " +
                                                Number(value).toLocaleString(
                                                    "en-GH"
                                                );
                                        }
                                    }
                                }
                            },

                            plugins: {
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            return context.dataset.label +
                                                ": " +
                                                formatCedi(context.parsed.y);
                                        }
                                    }
                                }
                            }
                        }
                    }
                );

                /*
                 * Chart 2: Expense breakdown.
                 * Never represent nonexistent expenses as real money.
                 */
                const hasExpenses =
                    expenseData.labels.length > 0 &&
                    expenseData.values.length > 0 &&
                    expenseData.values.some(
                        function(value) {
                            return Number(value) > 0;
                        }
                    );

                const expenseCanvas = document.getElementById(
                    "expenseChart"
                );

                if (!hasExpenses) {
                    expenseCanvas.hidden = true;

                    document.getElementById(
                        "expenseEmptyMessage"
                    ).hidden = false;
                } else {
                    new Chart(
                        expenseCanvas,
                        {
                            type: "doughnut",

                            data: {
                                labels: expenseData.labels,

                                datasets: [{
                                    label: "Expenses (GH₵)",
                                    data: expenseData.values,

                                    backgroundColor: [
                                        "#2563eb",
                                        "#16a34a",
                                        "#f59e0b",
                                        "#dc2626",
                                        "#7c3aed",
                                        "#0891b2",
                                        "#db2777",
                                        "#64748b",
                                        "#84cc16"
                                    ]
                                }]
                            },

                            options: {
                                responsive: true,
                                maintainAspectRatio: false,

                                plugins: {
                                    legend: {
                                        position: "bottom"
                                    },

                                    tooltip: {
                                        callbacks: {
                                            label: function(context) {
                                                return context.label +
                                                    ": " +
                                                    formatCedi(
                                                        context.parsed
                                                    );
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    );
                }

                /*
                 * Chart 3: Monthly net profit.
                 * Null values remain gaps when costs are incomplete.
                 */
                new Chart(
                    document.getElementById("profitChart"),
                    {
                        type: "line",

                        data: {
                            labels: profitData.labels,

                            datasets: [{
                                label: "Net Profit (GH₵)",
                                data: profitData.values,

                                borderColor: "#15803d",
                                backgroundColor:
                                    "rgba(21, 128, 61, 0.12)",

                                pointBackgroundColor: "#15803d",
                                pointRadius: 4,

                                fill: true,
                                tension: 0.25,
                                spanGaps: false
                            }]
                        },

                        options: {
                            responsive: true,
                            maintainAspectRatio: false,

                            scales: {
                                y: {
                                    ticks: {
                                        callback: function(value) {
                                            return "GH₵ " +
                                                Number(value).toLocaleString(
                                                    "en-GH"
                                                );
                                        }
                                    }
                                }
                            },

                            plugins: {
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            if (
                                                context.parsed.y === null
                                            ) {
                                                return (
                                                    "Profit unavailable: " +
                                                    "historical costs missing"
                                                );
                                            }

                                            return "Net Profit: " +
                                                formatCedi(
                                                    context.parsed.y
                                                );
                                        }
                                    }
                                }
                            }
                        }
                    }
                );
            }

            /*
             * Show date fields only for a custom reporting period.
             */
            function toggleCustomDates() {
                const periodElement = document.getElementById("period");

                if (!periodElement) {
                    return;
                }

                const isCustom =
                    periodElement.value === "custom";

                document.querySelectorAll(".custom-date").forEach(
                    function(field) {
                        field.style.display =
                            isCustom ? "block" : "none";
                    }
                );
            }

            /*
             * Initialize page behavior after HTML is available.
             */
            document.addEventListener("DOMContentLoaded", function() {
                toggleCustomDates();
                initializeCharts();
            });
        </script>

    {% endif %}

</div>
</body>
</html>
