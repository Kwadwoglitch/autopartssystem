class SaleItemInline(admin.TabularInline):
    model = SaleItem
    extra = 1


@admin.register(Sale)
class SaleAdmin(admin.ModelAdmin):
    list_display = (
        'invoice_number',
        'customer',
        'sale_date',
        'status',
        'payment_status',
    )

    search_fields = (
        'invoice_number',
        'customer__name',
        'customer__phone',
    )

    list_filter = (
        'status',
        'payment_status',
        'sale_date',
    )

    inlines = [SaleItemInline]
    actions = ['complete_selected_sales']

    @admin.action(description='Complete selected sales')
    def complete_selected_sales(self, request, queryset):
        completed_count = 0
        error_count = 0

        for sale in queryset:
            try:
                complete_sale(sale)
                completed_count += 1

            except ValueError as error:
                error_count += 1
                self.message_user(
                    request,
                    f'Sale {sale.invoice_number}: {error}',
                    level='error',
                )

        if completed_count:
            self.message_user(
                request,
                f'{completed_count} sale(s) completed successfully.',
            )

        if error_count:
            self.message_user(
                request,
                f'{error_count} sale(s) could not be completed.',
                level='warning',
            )


