from django.contrib import admin

from .models import (
    Product,
    Brand,
    Category,
    VehicleModel,
    Supplier,
    Purchase,
    PurchaseItem,
    InventoryTransaction,
    Customer,
    Sale,
    SaleItem,
    Payment,
)

from .services import receive_purchase, complete_sale

from django import forms
