class PurchaseItemInline(admin.TabularInline):
    model = PurchaseItem
    extra = 1


@admin.register(Purchase)
class PurchaseAdmin(admin.ModelAdmin):
    list_display = (
        'id',
        'supplier',
        'invoice_number',
        'purchase_date',
        'status',
        'created_at',
    )

    search_fields = (
        'invoice_number',
        'supplier__name',
    )

    list_filter = (
        'status',
        'supplier',
        'purchase_date',
    )

    inlines = [PurchaseItemInline]
    actions = ['receive_selected_purchases']

    @admin.action(description='Receive selected purchases')
    def receive_selected_purchases(self, request, queryset):
        received_count = 0
        error_count = 0

        for purchase in queryset:
            try:
                receive_purchase(purchase)
                received_count += 1

            except ValueError as error:
                error_count += 1
                self.message_user(
                    request,
                    f'Purchase #{purchase.id}: {error}',
                    level='error',
                )

        if received_count:
            self.message_user(
                request,
                f'{received_count} purchase(s) received successfully.',
            )

        if error_count:
            self.message_user(
                request,
                f'{error_count} purchase(s) could not be received.',
                level='warning',
            )


